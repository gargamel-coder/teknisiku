rules_version = '2';

// =============================================================================
// Firestore Security Rules — Teknisiku
// -----------------------------------------------------------------------------
// PENTING: aplikasi ini TIDAK punya login pengguna sungguhan (Firebase Auth).
// PIN admin/teknisi cuma gate tampilan di sisi browser, bukan otentikasi asli.
// Karena itu rules ini SENGAJA dibuat longgar (mirip localStorage lama: siapa
// saja yang tahu URL bisa baca/tulis) supaya app tetap jalan tanpa perlu bikin
// sistem login dulu. Ini cukup untuk versi awal/skala kecil, TAPI siapa pun
// yang tahu domain Firestore kamu (project id + apiKey, yang memang publik di
// kode frontend) bisa langsung baca/tulis semua data di bawah, termasuk lewat
// tool luar seperti curl — bukan cuma lewat app ini.
//
// Kalau nanti mau lebih aman, tambahkan Firebase Auth (Google Sign-In, email
// magic link, dst.) lalu ganti "true" di bawah dengan cek request.auth, dan
// simpan admin PIN sebagai custom claim / dokumen role, bukan hardcode di JS.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Teknisi yang ditambahkan lewat admin.html — publik bisa dibaca (index.html
    // & teknisi.html perlu baca ini tanpa login), tulis dibiarkan terbuka juga
    // karena admin.html belum punya Auth sungguhan.
    match /custom_technicians/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Pesanan dari index.html. Dibaca ulang oleh teknisi.html.
    match /orders/{id} {
      allow read: if true;
      allow create: if true;
      // update dipakai untuk ubah status/assign — dibiarkan terbuka juga.
      allow update: if true;
      allow delete: if false; // tidak ada fitur hapus order dari UI manapun
    }

    // Review konsumen (menunggu moderasi admin).
    match /pending_reviews/{id} {
      allow read: if true;
      allow create: if true;   // index.html: konsumen kirim review baru
      allow update: if true;   // admin.html: approve/reject
      allow delete: if false;
    }

    // Iklan/boost teknisi dari admin.html.
    match /featured_listings/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Anggota tim tiap teknisi (teknisi.html).
    match /team_members/{id} {
      allow read: if true;
      allow write: if true;
    }

    // PIN custom teknisi (fallback pengganti last-4-digit nomor HP).
    match /tech_pins/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Log analitik — hanya perlu ditambah (create), tidak pernah diubah/dihapus.
    match /visits/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /searches/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /wa_clicks/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Default: tolak semua koleksi lain yang tidak disebut di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
